<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.robin.wavetype</string>

	<!-- 直接跑 venv 里的解释器，绕过 start.sh 的交互式提示 -->
	<key>ProgramArguments</key>
	<array>
		<string>/Users/robinwang/Coding/语音输入本地部署/.venv/bin/python3</string>
		<string>-u</string>
		<string>/Users/robinwang/Coding/语音输入本地部署/main.py</string>
		<!-- 应用日志自行轮转写入（5MB×3）；排查热键时临时加 -v 打开 DEBUG -->
		<string>--log-file</string>
		<string>/Users/robinwang/Library/Logs/WaveType/wavetype.log</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/robinwang/Coding/语音输入本地部署</string>

	<!-- 登录即启动 -->
	<key>RunAtLoad</key>
	<true/>

	<!-- 任何退出都拉起。旧配置 SuccessfulExit=false 时，菜单「退出」（退出码 0）后
	     服务不再启动，直到下次登录（2026-11-09 实际发生，停了两天）。
	     真正停止服务走菜单「退出」→ launchctl bootout。 -->
	<key>KeepAlive</key>
	<true/>

	<!-- 反复失败时的最小重启间隔，防止疯狂重启刷日志 -->
	<key>ThrottleInterval</key>
	<integer>30</integer>

	<!-- 这是带窗口的应用（HUD/答案卡片），给它交互优先级 -->
	<key>ProcessType</key>
	<string>Interactive</string>

	<!-- 应用日志由 --log-file 写 wavetype.log（自带轮转）；这里只接未捕获异常等 stderr 输出 -->
	<key>StandardErrorPath</key>
	<string>/Users/robinwang/Library/Logs/WaveType/wavetype.stderr.log</string>
	<key>StandardOutPath</key>
	<string>/Users/robinwang/Library/Logs/WaveType/wavetype.stdout.log</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
	</dict>
</dict>
</plist>
